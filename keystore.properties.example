# Copiar a keystore.properties (ignorado por git) y rellenar los valores que
# faltan. Alternativa para CI: variables de entorno PRACTICAPRO_STORE_FILE,
# PRACTICAPRO_STORE_PASSWORD, PRACTICAPRO_KEY_ALIAS, PRACTICAPRO_KEY_PASSWORD.
#
# Si falta cualquiera de los cuatro, la release sale SIN FIRMAR. No se recurre
# a la keystore de debug: su clave es pública y compartida, así que firmar con
# ella permitiría a cualquiera publicar una actualización suplantando la app.
#
# Consultar el alias de una keystore existente:
#   keytool -list -v -keystore C:/Users/bigma/keystore/practicapro.jks

storeFile=C:/Users/bigma/keystore/practicapro.jks
storePassword=
keyAlias=
keyPassword=
