<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de copia para API 31 y superiores. Mismo criterio que
   backup_rules.xml, en los dos canales: nube y traspaso entre dispositivos.
   Los dos bloques han de declararse; omitir uno deja ese canal con las reglas
   por omisión, que sí arrastran el WAL.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="app_database-wal" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="app_database-wal" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-journal" />
    </device-transfer>
</data-extraction-rules>
