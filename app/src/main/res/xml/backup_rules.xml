<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de copia para API 30. Se respalda todo salvo los auxiliares de
   SQLite: un WAL copiado a destiempo deja la base inconsistente al restaurar
   y Room la borra entera al detectar corrupción. El archivo principal se
   vuelca al pasar la app a segundo plano (AppLifecycleObserver).
-->
<full-backup-content>
    <exclude domain="database" path="app_database-wal" />
    <exclude domain="database" path="app_database-shm" />
    <exclude domain="database" path="app_database-journal" />
</full-backup-content>
